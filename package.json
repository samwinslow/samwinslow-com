{
  "name": "samwinslow-com",
  "version": "1.0.0",
  "description": "Statically-generated minimal personal site",
  "homepage": "https://github.com/samwinslow/samwinslow-com#readme",
  "bugs": {
    "url": "https://github.com/samwinslow/samwinslow-com/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samwinslow/samwinslow-com.git"
  },
  "author": "samwinslow",
  "scripts": {
    "build": "tsx src/build.ts",
    "watch": "nodemon --watch src --ext ts,html,mdx --exec 'tsx src/build.ts'",
    "dev": "concurrently \"npm run watch\" \"serve dist\""
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node": "^25.9.2",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.0",
    "mustache": "^4.2.0",
    "nodemon": "^3.1.14",
    "serve": "^14.2.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
